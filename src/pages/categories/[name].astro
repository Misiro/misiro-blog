---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndexRow from '../../components/IndexRow.astro';
import { getPosts, categoryCounts } from '../../lib/content';
import { padNumber } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getPosts();
  return categoryCounts(posts).map((category) => ({
    params: { name: category.name },
    props: {
      name: category.name,
      posts: posts.filter((post) => post.data.category === category.name),
    },
  }));
}

const { name, posts } = Astro.props;
---

<BaseLayout title={`分类：${name}`} description={`分类「${name}」下的全部文章。`}>
  <section class="page-hero">
    <div class="container">
      <nav class="crumbs mono" aria-label="面包屑">
        <a href="/categories">分类</a>
        <span aria-hidden="true">/</span>
        <span class="crumbs__now">{name}</span>
      </nav>
      <h1 class="page-hero__title glitch">{name}</h1>
      <p class="page-hero__desc">{padNumber(posts.length, 2)} 篇文章归在这一类。</p>
    </div>
  </section>

  <div class="container">
    <div class="index-list">
      {posts.map((post, index) => <IndexRow post={post} index={index + 1} showDesc />)}
    </div>
  </div>
</BaseLayout>

<style>
  .crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font-size: var(--fs-micro);
  }

  .crumbs__now {
    color: var(--accent-text);
  }
</style>
