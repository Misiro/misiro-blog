  }

  .id-card__glyph {
    font-family: var(--font-display);
    font-size: 96px;
    line-height: 1;
    color: var(--text);
    text-shadow:
      3px 0 0 rgba(52, 224, 224, 0.35),
      -3px 0 0 rgba(255, 61, 129, 0.35);
  }

  .id-card__ring {
    position: absolute;
    inset: 0;
    border: 1px dashed var(--line-strong);
    border-radius: 50%;
    animation: id-spin 8s linear infinite;
  }

  .id-card__ring--b {
    inset: 14px;
    border: 0;
    background: conic-gradient(
      from 0deg,
      rgba(216, 255, 62, 0) 0deg,
      rgba(216, 255, 62, 0.95) 12deg,
      rgba(216, 255, 62, 0.5) 78deg,
      rgba(216, 255, 62, 0.16) 158deg,
      rgba(216, 255, 62, 0) 226deg,
      rgba(216, 255, 62, 0) 360deg
    );
    -webkit-mask-image: radial-gradient(circle, transparent 0 68px, #000 68px 70px);
    mask-image: radial-gradient(circle, transparent 0 68px, #000 68px 70px);
    animation-duration: 4s;
  }

  :root[data-theme='light'] .id-card__ring--b {
    background: conic-gradient(
      from 0deg,
      rgba(90, 107, 0, 0) 0deg,
      rgba(90, 107, 0, 0.95) 12deg,
      rgba(90, 107, 0, 0.5) 78deg,
      rgba(90, 107, 0, 0.16) 158deg,
      rgba(90, 107, 0, 0) 226deg,
      rgba(90, 107, 0, 0) 360deg
    );
  }

  @keyframes id-spin { to { rotate: 360deg; } }

  .id-card__scan {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(216, 255, 62, 0.08) 46%,
      rgba(216, 255, 62, 0.16) 50%,
      rgba(216, 255, 62, 0.08) 54%,
      transparent
    );
    background-size: 100% 260%;
    animation: id-scan 4s var(--ease-inout) infinite alternate;
    mix-blend-mode: screen;
  }

  :root[data-theme='light'] .id-card__scan {
    mix-blend-mode: multiply;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(90, 107, 0, 0.07) 46%,
      rgba(90, 107, 0, 0.14) 50%,
      rgba(90, 107, 0, 0.07) 54%,
      transparent
    );
    background-size: 100% 260%;
  }

  @keyframes id-scan {
    from { background-position: 0 70%; }
    to { background-position: 0 -70%; }
  }

  .id-card__meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    color: var(--text-muted);
    font-size: var(--fs-micro);
    letter-spacing: 0.1em;
  }

  /* ---------- 页面主轴 ---------- */
  .about {
    position: relative;
    padding-bottom: clamp(64px, 8vw, 112px);
  }

  .about-rail {
    position: fixed;
    left: 20px;
    top: 50%;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    translate: 0 -50%;
    z-index: 3;
    pointer-events: none;
  }

  @media (min-width: 1460px) {
    .about-rail { display: flex; }
  }

  .about-rail__tag {
    font-size: var(--fs-nano);
    letter-spacing: 0.34em;
    color: var(--text-muted);
    writing-mode: vertical-rl;
  }

  .about-rail__track {
    position: relative;
    width: 1px;
    height: clamp(140px, 18vh, 200px);
    background: var(--line);
  }

  .about-rail__track i {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 100%;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 140ms linear;
  }

  .about-rail__count {
    color: var(--accent-text);
    font-size: var(--fs-micro);
    letter-spacing: 0.12em;
  }

  /* ---------- 章节骨架 ---------- */
  .sec {
    position: relative;
    display: grid;
    grid-template-columns: var(--spine) minmax(0, 1fr);
    column-gap: var(--spine-gap);
    padding-block: clamp(40px, 4.6vw, 68px);
    border-top: 1px solid var(--line);
  }

  .about > .sec:first-of-type {
    border-top: 0;
    padding-top: clamp(34px, 4vw, 56px);
  }

  .sec::before {
    content: '';
    position: absolute;
    top: -4px;
    right: 0;
    width: 7px;
    height: 7px;
    border-top: 1px solid var(--line-strong);
    border-right: 1px solid var(--line-strong);
    pointer-events: none;
  }

  .sec__head {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    align-self: start;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding-top: 2px;
  }

  .sec__idx {
    color: transparent;
    -webkit-text-stroke: 1px var(--accent);
    font-family: var(--font-display);
    font-size: clamp(26px, 2.4vw, 34px);
    line-height: 1;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    transition: color 320ms var(--ease-quart);
  }

  .sec__head:hover .sec__idx { color: var(--accent-text); }

  .sec__kicker {
    margin-top: 4px;
    color: var(--text);
    font-size: var(--fs-nano);
    letter-spacing: 0.26em;
  }

  .sec__cn {
    color: var(--text-muted);
    font-size: var(--fs-micro);
    letter-spacing: 0.1em;
  }

  .sec__spine {
    display: block;
    width: 1px;
    height: clamp(30px, 4vw, 52px);
    margin-top: 12px;
    background: linear-gradient(to bottom, var(--line-strong), transparent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 760ms var(--ease-expo) 140ms;
  }

  .reveal.is-in .sec__spine { transform: scaleY(1); }

  .sec__body {
    position: relative;
    min-width: 0;
  }

  /* ---------- 入场 ---------- */
  .reveal { opacity: 0; transition: opacity 720ms var(--ease-expo); }
  .reveal.is-in { opacity: 1; }

  .reveal .stagger-item {
    opacity: 0;
    translate: 0 22px;
    transition:
      opacity 680ms var(--ease-expo) var(--d, 0ms),
      translate 680ms var(--ease-expo) var(--d, 0ms);
  }

  .reveal.is-in .stagger-item {
    opacity: 1;
    translate: 0 0;
  }

  .reveal .sec__head {
    opacity: 0;
    translate: 0 14px;
    transition:
      opacity 640ms var(--ease-expo),
      translate 640ms var(--ease-expo);
  }

  .reveal.is-in .sec__head {
    opacity: 1;
    translate: 0 0;
  }

  /* ---------- 01 身份 ---------- */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.42fr) minmax(0, 0.78fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: stretch;
  }

  .intro__body { min-width: 0; }

  .intro__hello {
    color: var(--accent-text);
    font-size: var(--fs-micro);
    letter-spacing: 0.24em;
  }

  .intro__name {
    margin-top: 12px;
    font-family: var(--font-display);
    font-size: clamp(32px, 4.2vw, 54px);
    line-height: 1.08;
  }

  .intro__name-accent {
    color: transparent;
    -webkit-text-stroke: 1px var(--accent);
    letter-spacing: 0.02em;
  }

  .intro__cursor {
    display: inline-block;
    width: 0.34em;
    height: 0.84em;
    margin-left: 10px;
    background: var(--accent);
    vertical-align: -0.05em;
    animation: dot-blink 2s steps(2, jump-none) infinite;
  }

  .intro__motto {
    min-height: 1.7em;
    margin-top: 14px;
    color: var(--accent-text);
    font-size: var(--fs-caption);
    letter-spacing: 0.05em;
  }

  .intro__text {
    max-width: 58ch;
    margin-top: 22px;
    color: var(--text-muted);
    font-size: 15px;
    line-height: 1.95;
  }

  .intro__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }

  .intro__tag {
    padding: 5px 11px;
    border: 1px solid var(--line-strong);
    color: var(--text-muted);
    font-size: var(--fs-micro);
    letter-spacing: 0.12em;
    transition:
      border-color var(--dur-3) var(--ease-quart),
      color var(--dur-3) var(--ease-quart),
      translate var(--dur-3) var(--ease-quart);
  }

  .intro__tag:hover {
    border-color: var(--accent);
    color: var(--accent-text);
    translate: 0 -3px;
  }

  .intro__quote {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    min-height: 190px;
    padding: 16px 20px 16px 24px;
    border-left: 2px solid var(--accent);
    background: linear-gradient(100deg, color-mix(in srgb, var(--accent) 7%, transparent), transparent 72%);
  }

  .intro__quote-index {
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.2em;
  }

  .intro__quote-mark {
    color: var(--accent-text);
    font-family: var(--font-display);
    font-size: 44px;
    line-height: 0.8;
  }

  .intro__quote-text {
    color: var(--text-muted);
    font-size: var(--fs-micro);
    line-height: 2.1;
    letter-spacing: 0.18em;
  }

  .intro__quote-rule {
    display: block;
    height: 1px;
    background: var(--line-strong);
  }

  .profile-rows {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(24px, 3.6vw, 56px);
    margin-top: clamp(28px, 3.4vw, 44px);
    border-top: 1px solid var(--line);
  }

  .profile-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    transition: padding-left var(--dur-3) var(--ease-quart);
  }

  .profile-row:hover { padding-left: 8px; }

  .profile-row__k {
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.16em;
    white-space: nowrap;
  }

  .profile-row__v {
    color: var(--text);
    font-size: var(--fs-mono);
    text-align: right;
    line-height: 1.5;
  }

  .profile-row:hover .profile-row__k { color: var(--accent-text); }

  /* ---------- 02 遥测 ---------- */
  .telemetry {
    display: grid;
    grid-template-columns: 1.45fr repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--line);
  }

  .stat-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 22px;
    min-height: clamp(148px, 15vw, 186px);
    padding: 20px 20px 18px;
    border-left: 1px solid var(--line);
    transition: background 320ms var(--ease-quart);
  }

  .stat-card:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .stat-card:hover { background: color-mix(in srgb, var(--accent) 5%, transparent); }

  .stat-card__label {
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.16em;
    line-height: 1.5;
  }

  .stat-card__value {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(34px, 4.6vw, 62px);
    line-height: 0.9;
    color: var(--text);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .stat-card:first-child .stat-card__value { color: var(--accent-text); }

  .stat-card__bar {
    display: block;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--line-strong) 0 5px, transparent 5px 10px);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 900ms var(--ease-expo) 180ms;
  }

  .stat-card:first-child .stat-card__bar {
    background: repeating-linear-gradient(90deg, var(--accent) 0 6px, transparent 6px 12px);
  }

  .reveal.is-in .stat-card__bar { transform: scaleX(1); }

  .telemetry__note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.16em;
  }

  .telemetry__note-dot {
    width: 5px;
    height: 5px;
    background: var(--accent-2);
    animation: dot-blink 2.4s steps(2, jump-none) infinite;
  }

  /* ---------- 03 人格 ---------- */
  .persona {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
  }

  .persona__main { min-width: 0; }

  .persona__label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.22em;
  }

  .persona__label::before {
    content: '';
    width: 5px;
    height: 5px;
    rotate: 45deg;
    background: var(--accent-3);
    box-shadow: 0 0 10px color-mix(in srgb, var(--accent-3) 70%, transparent);
  }

  .persona__name {
    margin-top: 12px;
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.1;
  }

  .persona__code {
    margin-top: 4px;
    font-family: var(--font-display);
    font-size: clamp(56px, 8vw, 118px);
    line-height: 0.92;
    letter-spacing: 0.01em;
    background-image: linear-gradient(
      100deg,
      var(--accent) 0%,
      var(--accent-2) 48%,
      var(--accent-3) 100%
    );
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: persona-flow 9s var(--ease-inout) infinite alternate;
  }

  @keyframes persona-flow {
    from { background-position: 0% 50%; }
    to { background-position: 100% 50%; }
  }

  :root[data-theme='light'] .persona__code {
    background-image: linear-gradient(
      100deg,
      var(--accent-text) 0%,
      var(--accent-2) 48%,
      var(--accent-3) 100%
    );
  }

  .persona__desc {
    max-width: 54ch;
    margin-top: 18px;
    padding-left: 16px;
    border-left: 2px solid color-mix(in srgb, var(--accent-3) 52%, transparent);
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.95;
  }

  .persona__axes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px clamp(20px, 3vw, 44px);
    margin-top: 26px;
  }

  .persona-axis__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 8px;
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.12em;
  }

  .persona-axis__head b {
    color: var(--text);
    font-weight: 400;
  }

  .persona-axis__bar {
    position: relative;
    height: 3px;
    background: var(--line-strong);
  }

  .persona-axis__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--p);
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--accent) 22%, transparent),
      var(--accent)
    );
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 900ms var(--ease-expo) calc(280ms + var(--d, 0ms));
  }

  .reveal.is-in .persona-axis__fill { transform: scaleX(1); }

  .persona-axis__mark {
    position: absolute;
    left: var(--p);
    top: -3px;
    width: 1px;
    height: 9px;
    translate: -1px 0;
    background: var(--accent-2);
    box-shadow: 0 0 10px color-mix(in srgb, var(--accent-2) 70%, transparent);
    opacity: 0;
    transition: opacity 240ms var(--ease-quart) calc(1000ms + var(--d, 0ms));
  }

  .reveal.is-in .persona-axis__mark { opacity: 1; }

  .persona__notes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }

  .persona__notes span {
    padding: 4px 10px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg-elevated) 82%, transparent);
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.1em;
    transition:
      color 240ms var(--ease-quart),
      border-color 240ms var(--ease-quart);
  }

  .persona__notes span::before {
    content: '+';
    margin-right: 6px;
    color: var(--accent-text);
  }

  .persona__notes span:hover {
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
  }

  .persona__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 26px;
    padding-bottom: 5px;
    border-bottom: 1px solid var(--line-strong);
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.16em;
    transition:
      gap 300ms var(--ease-quart),
      color 300ms var(--ease-quart),
      border-color 300ms var(--ease-quart);
  }

  .persona__link span {
    color: var(--accent-text);
    font-size: var(--fs-micro);
  }

  .persona__link:hover {
    gap: 12px;
    color: var(--accent-text);
    border-bottom-color: var(--accent);
  }

  .persona__sigil {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 340px);
    aspect-ratio: 1;
    justify-self: center;
  }

  .persona__glow {
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--accent-3) 15%, transparent),
      transparent 62%
    );
    animation: persona-glow 7s var(--ease-inout) infinite alternate;
  }

  @keyframes persona-glow {
    from { opacity: 0.35; scale: 0.94; }
    to { opacity: 0.9; scale: 1.04; }
  }

  .persona__sigil::after {
    content: '';
    position: absolute;
    inset: 0;
    height: 32%;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--accent) 9%, transparent) 45%,
      color-mix(in srgb, var(--accent) 22%, transparent) 50%,
      transparent
    );
    opacity: 0;
    pointer-events: none;
    animation: ps-scan 5.5s var(--ease-inout) infinite;
  }

  @keyframes ps-scan {
    0% { translate: 0 -40%; opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { translate: 0 210%; opacity: 0; }
  }

  .persona__svg {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
  }

  .ps-ring { fill: none; }

  .ps-ring--outer {
    stroke: var(--line-strong);
    stroke-width: 1;
    stroke-dasharray: 2 7;
    transform-box: fill-box;
    transform-origin: center;
    animation: ps-turn 32s linear infinite;
  }

  .ps-ring--inner {
    stroke: color-mix(in srgb, var(--accent) 34%, transparent);
    stroke-width: 1;
    stroke-dasharray: 18 10;
    transform-box: fill-box;
    transform-origin: center;
    animation: ps-turn 18s linear infinite reverse;
  }

  .ps-cross {
    stroke: var(--line-strong);
    stroke-width: 1;
  }

  .ps-spin {
    transform-box: fill-box;
    transform-origin: center;
    animation: ps-turn 14s linear infinite;
  }

  .ps-node { fill: var(--accent-2); }

  .ps-core polygon {
    fill: var(--accent);
    stroke: color-mix(in srgb, var(--accent) 55%, transparent);
    stroke-width: 0.6;
  }

  .ps-core polygon:nth-child(2) { fill: var(--accent-2); }
  .ps-core polygon:nth-child(3) { fill: var(--accent-3); }

  .ps-letter {
    fill: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.12em;
  }

  .ps-code {
    fill: var(--text);
    font-family: var(--font-display);
    font-size: 20px;
    letter-spacing: 0.12em;
  }

  @keyframes ps-turn {
    to { transform: rotate(360deg); }
  }

  /* ---------- 04 能力 ---------- */
  .mastery {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.85fr);
    gap: clamp(26px, 3.6vw, 52px);
    align-items: start;
  }

  .skill-panel {
    position: relative;
    padding: 24px 24px 14px;
    background:
      radial-gradient(
        circle at 50% 45%,
        color-mix(in srgb, var(--accent) 9%, transparent),
        transparent 62%
      ),
      repeating-linear-gradient(0deg, transparent 0 11px, var(--line) 11px 12px),
      repeating-linear-gradient(90deg, transparent 0 11px, var(--line) 11px 12px),
      var(--bg-elevated);
  }

  .skill-radar {
    display: block;
    width: 100%;
    height: clamp(260px, 28vw, 340px);
  }

  .skill-panel__hint {
    position: absolute;
    right: 16px;
    bottom: 12px;
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.16em;
  }

  .mastery__side { min-width: 0; }

  .skill-bars {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill-bar__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    font-size: var(--fs-caption);
  }

  .skill-bar__num {
    color: var(--accent-text);
    font-size: var(--fs-micro);
    font-variant-numeric: tabular-nums;
  }

  .skill-bar__track {
    height: 5px;
    margin-top: 9px;
    background: var(--bg-elevated-2);
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .skill-bar__fill {
    display: block;
    height: 100%;
    width: var(--p);
    background: repeating-linear-gradient(-45deg, var(--accent) 0 8px, transparent 8px 14px);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 860ms var(--ease-expo) var(--d, 0ms);
  }

  .skill-bar.is-in .skill-bar__fill { transform: scaleX(1); }

  :root[data-theme='light'] .skill-bar__fill {
    background: repeating-linear-gradient(-45deg, var(--accent-text) 0 8px, transparent 8px 14px);
  }

  .mastery__note {
    margin-top: 24px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    color: var(--text-muted);
    font-size: var(--fs-micro);
    letter-spacing: 0.1em;
  }

  /* ---------- 04 军械库 ---------- */
  .arsenal {
    margin-top: clamp(26px, 3.4vw, 44px);
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .arsenal__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  .arsenal__title {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--text);
    font-size: var(--fs-micro);
    letter-spacing: 0.2em;
  }

  .arsenal__title::before {
    content: '';
    width: 5px;
    height: 5px;
    rotate: 45deg;
    background: var(--accent);
  }

  .arsenal__meta {
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.16em;
  }

  .arsenal__row {
    --ac: var(--accent);
    position: relative;
    margin-top: 15px;
  }

  .arsenal__row--b {
    --ac: var(--accent-2);
    margin-top: 12px;
  }

  .arsenal__row-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 7px;
    border-bottom: 1px solid var(--line);
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.16em;
  }

  .arsenal__row-id {
    display: grid;
    place-items: center;
    width: 17px;
    height: 17px;
    border: 1px solid color-mix(in srgb, var(--ac) 55%, transparent);
    color: var(--ac);
    font-size: var(--fs-nano);
    line-height: 1;
  }

  .arsenal__row-name {
    color: var(--text);
    letter-spacing: 0.14em;
  }

  .arsenal__row-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--line), transparent);
  }

  .arsenal__row-dir {
    color: var(--ac);
    letter-spacing: 0.08em;
  }

  .arsenal__viewport {
    position: relative;
    margin-top: 9px;
    padding-block: 5px;
    overflow: hidden;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--bg-elevated) 92%, transparent),
      var(--bg-elevated)
    );
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
  }

  .arsenal__track {
    display: flex;
    width: max-content;
    animation: arsenal-belt 52s linear infinite;
    will-change: transform;
  }

  .arsenal__track--b {
    translate: -64px 0;
    animation-direction: reverse;
    animation-duration: 68s;
  }

  .arsenal__viewport:hover .arsenal__track,
  .arsenal__viewport:focus-within .arsenal__track {
    animation-play-state: paused;
  }

  .arsenal__group {
    display: flex;
    flex: 0 0 auto;
  }

  @keyframes arsenal-belt {
    to { transform: translate3d(-50%, 0, 0); }
  }

  .arsenal__item {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 13px 30px 13px 13px;
    border-right: 1px solid var(--line);
    transition:
      background 300ms var(--ease-quart),
      opacity 300ms var(--ease-quart),
      translate 300ms var(--ease-expo);
  }

  .arsenal__viewport:has(.arsenal__item:hover) .arsenal__item:not(:hover) {
    opacity: 0.34;
    filter: saturate(0.6);
  }

  .arsenal__item:hover {
    translate: 0 -3px;
    background: color-mix(in srgb, var(--c) 10%, transparent);
  }

  .arsenal__item::after {
    content: '';
    position: absolute;
    left: 13px;
    right: 30px;
    bottom: 0;
    height: 1px;
    background: var(--c);
    opacity: 0.8;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 420ms var(--ease-expo);
  }

  .arsenal__item:hover::after { transform: scaleX(1); }

  .arsenal__idx {
    position: absolute;
    top: 9px;
    right: 9px;
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
    opacity: 0.35;
    transition: opacity 300ms var(--ease-quart);
  }

  .arsenal__item:hover .arsenal__idx { opacity: 0.9; }

  .arsenal__tile {
    position: relative;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 50px;
    height: 50px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--c) 7%, transparent);
    transition:
      border-color 300ms var(--ease-quart),
      background 300ms var(--ease-quart),
      box-shadow 300ms var(--ease-quart);
  }

  .arsenal__tile svg {
    position: relative;
    z-index: 1;
    width: 29px;
    height: 29px;
    transition: scale 380ms var(--ease-expo);
  }

  .arsenal__tile::after {
    content: '';
    position: absolute;
    inset: -60% -45%;
    background: linear-gradient(
      100deg,
      transparent 44%,
      rgba(255, 255, 255, 0.42) 50%,
      transparent 56%
    );
    opacity: 0;
    translate: -45% 0;
    pointer-events: none;
  }

  .arsenal__item:hover .arsenal__tile {
    border-color: color-mix(in srgb, var(--c) 62%, transparent);
    background: color-mix(in srgb, var(--c) 13%, transparent);
    box-shadow:
      0 0 18px color-mix(in srgb, var(--c) 32%, transparent),
      inset 0 0 12px color-mix(in srgb, var(--c) 14%, transparent);
  }

  .arsenal__item:hover .arsenal__tile svg { scale: 1.12; }

  .arsenal__item:hover .arsenal__tile::after {
    animation: arsenal-glint 900ms var(--ease-inout);
  }

  @keyframes arsenal-glint {
    from { translate: -60% 0; opacity: 0; }
    35% { opacity: 0.95; }
    to { translate: 60% 0; opacity: 0; }
  }

  .arsenal__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .arsenal__name {
    color: var(--text);
    font-size: var(--fs-micro);
    letter-spacing: 0.1em;
    white-space: nowrap;
    transition: color 300ms var(--ease-quart);
  }

  .arsenal__role {
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.18em;
    white-space: nowrap;
    opacity: 0.62;
    transition: opacity 300ms var(--ease-quart);
  }

  .arsenal__item:hover .arsenal__role { opacity: 1; }

  .arsenal__foot {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.16em;
  }

  .arsenal__foot-dot {
    width: 4px;
    height: 4px;
    background: var(--accent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 70%, transparent);
    animation: arsenal-pulse 1.8s var(--ease-inout) infinite alternate;
  }

  @keyframes arsenal-pulse {
    from { opacity: 0.9; }
    to { opacity: 0.22; }
  }

  .arsenal__foot-hint { margin-left: auto; }

  /* ---------- 05 偏好 ---------- */
  .taste {
    display: grid;
    grid-template-columns: minmax(0, 1.28fr) minmax(0, 0.82fr);
    align-items: start;
    column-gap: clamp(32px, 5vw, 80px);
  }

  .taste__col { min-width: 0; }

  .taste__col--hate {
    margin-top: clamp(30px, 4.6vw, 62px);
    padding-left: clamp(20px, 2.6vw, 40px);
    border-left: 1px solid var(--line);
  }

  .taste__head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--line-strong);
  }

  .taste__tag {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--text);
    font-size: var(--fs-micro);
    letter-spacing: 0.22em;
  }

  .taste__tag::before {
    content: '';
    width: 5px;
    height: 5px;
    rotate: 45deg;
    background: var(--accent);
  }

  .taste__col--hate .taste__tag { color: var(--text-muted); }

  .taste__col--hate .taste__tag::before { background: var(--accent-3); }

  .taste__count {
    margin-left: auto;
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.16em;
  }

  .taste__list { margin-top: 6px; }

  .taste-row {
    position: relative;
    display: grid;
    grid-template-columns: clamp(34px, 4vw, 52px) minmax(0, 1fr);
    align-items: start;
    column-gap: clamp(10px, 1.4vw, 20px);
    padding-block: clamp(15px, 1.7vw, 23px);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    translate: 0 12px;
    clip-path: inset(0 0 100% 0);
    transition:
      opacity 560ms var(--ease-expo) var(--d, 0ms),
      translate 700ms var(--ease-expo) var(--d, 0ms),
      clip-path 700ms var(--ease-expo) var(--d, 0ms);
  }

  .reveal.is-in .taste-row {
    opacity: 1;
    translate: 0 0;
    clip-path: inset(0 0 0 0);
  }

  .taste-row::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 520ms var(--ease-expo);
  }

  .taste__col--hate .taste-row::after { background: var(--accent-3); }

  .taste-row:hover::after { transform: scaleX(1); }

  .taste-row__idx {
    padding-top: 1px;
    font-family: var(--font-display);
    font-size: clamp(20px, 2.2vw, 30px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-strong);
    font-variant-numeric: tabular-nums;
    transition: -webkit-text-stroke-color 320ms var(--ease-quart);
  }

  .taste-row:hover .taste-row__idx { -webkit-text-stroke-color: var(--accent); }

  .taste__col--hate .taste-row:hover .taste-row__idx {
    -webkit-text-stroke-color: var(--accent-3);
  }

  .taste-row__main {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .taste-row__name {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(21px, 2.1vw, 27px);
    line-height: 1.14;
    letter-spacing: -0.015em;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition:
      translate 360ms var(--ease-expo),
      color 280ms var(--ease-quart),
      background-size 460ms var(--ease-expo);
  }

  .taste-row:hover .taste-row__name {
    translate: 6px 0;
    color: var(--accent-text);
    background-size: 100% 1px;
  }

  .taste__col--hate .taste-row__name {
    font-size: clamp(18px, 1.8vw, 23px);
    color: color-mix(in srgb, var(--text) 82%, transparent);
    background-image: linear-gradient(var(--accent-3), var(--accent-3));
  }

  .taste__col--hate .taste-row:hover .taste-row__name { color: var(--accent-3); }

  .taste-row__note {
    color: var(--text-muted);
    font-size: 11.5px;
    line-height: 1.6;
    letter-spacing: 0.01em;
    opacity: 0.6;
    translate: 0 2px;
    transition:
      opacity 320ms var(--ease-quart),
      translate 360ms var(--ease-expo),
      color 320ms var(--ease-quart);
  }

  .taste-row:hover .taste-row__note {
    color: var(--text);
    opacity: 1;
    translate: 0 0;
  }

  .taste__col--hate .taste-row:hover .taste-row__note {
    color: var(--accent-3);
    opacity: 0.86;
  }

  /* 容差：三列纯文字，描边数字 + 细刻度 */
  .traits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3.4vw, 48px);
    margin-top: clamp(36px, 5vw, 64px);
    padding-top: clamp(20px, 2.4vw, 28px);
    border-top: 1px solid var(--line-strong);
  }

  .traits__head {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  .traits__label {
    color: var(--text);
    font-size: var(--fs-micro);
    letter-spacing: 0.22em;
  }

  .traits__meta {
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.16em;
  }

  .trait {
    min-width: 0;
    opacity: 0;
    translate: 0 16px;
    transition:
      opacity 620ms var(--ease-expo) var(--d, 0ms),
      translate 700ms var(--ease-expo) var(--d, 0ms);
  }

  .reveal.is-in .trait {
    opacity: 1;
    translate: 0 0;
  }

  .trait__head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    min-width: 0;
  }

  .trait__num {
    font-family: var(--font-display);
    font-size: clamp(34px, 3.6vw, 48px);
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-strong);
    font-variant-numeric: tabular-nums;
    transition: -webkit-text-stroke-color 320ms var(--ease-quart);
  }

  .trait:hover .trait__num {
    -webkit-text-stroke-color: color-mix(in srgb, var(--accent-2) 72%, transparent);
  }

  .trait__name {
    font-size: var(--fs-caption);
    letter-spacing: 0.02em;
  }

  .trait__idx {
    margin-left: auto;
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.14em;
    opacity: 0.6;
  }

  .trait__gauge {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 3px;
    margin-top: 14px;
  }

  .trait__gauge i {
    height: 3px;
    background: var(--line);
    transform: scaleX(0);
    transform-origin: left;
    transition:
      transform 620ms var(--ease-expo) calc(var(--s, 0) * 34ms + 120ms),
      background 300ms var(--ease-quart);
  }

  .reveal.is-in .trait__gauge i { transform: scaleX(1); }

  .trait__gauge i.is-lit {
    background: color-mix(in srgb, var(--accent-2) 58%, transparent);
  }

  .trait:hover .trait__gauge i.is-lit { background: var(--accent-2); }

  .trait__note {
    margin-top: 10px;
    color: var(--text-muted);
    font-size: var(--fs-micro);
    line-height: 1.6;
    letter-spacing: 0.02em;
  }

  @keyframes dot-blink {
    50% { opacity: 0.2; }
  }

  /* ---------- 06 娱乐 ---------- */
  .media { min-width: 0; }

  .media-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-strong);
  }

  .media-head__label {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--text);
    font-size: var(--fs-micro);
    letter-spacing: 0.22em;
  }

  .media-head__label i {
    width: 5px;
    height: 5px;
    rotate: 45deg;
    background: var(--accent);
  }

  .media-head--reel .media-head__label i { background: var(--accent-3); }

  .media-head__meta {
    margin-left: auto;
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.16em;
  }

  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1.58fr) minmax(0, 1fr);
    align-items: start;
    column-gap: clamp(24px, 3.2vw, 48px);
    padding-top: clamp(20px, 2.4vw, 34px);
  }

  .feature__hero { min-width: 0; }

  .feature__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--bg-elevated);
  }

  .feature__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    font-size: var(--fs-nano);
    letter-spacing: 0.18em;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.65);
  }

  .feature__badge::before {
    content: '';
    width: 5px;
    height: 5px;
    background: var(--accent);
  }

  .feature__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    clip-path: inset(0 0 100% 0);
    filter: saturate(0.94) contrast(1.05) brightness(0.96);
    transition:
      clip-path 1000ms var(--ease-expo),
      scale 1200ms var(--ease-expo),
      filter 520ms var(--ease-quart);
  }

  .reveal.is-in .feature__img { clip-path: inset(0 0 0 0); }

  .feature__hero:hover .feature__img {
    scale: 1.02;
    filter: saturate(1.06) contrast(1.03) brightness(1.04);
  }

  .feature__cap { padding-top: 14px; }

  .feature__idx {
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.16em;
  }

  .feature__title {
    margin-top: 6px;
    font-family: var(--font-display);
    font-size: clamp(24px, 2.6vw, 32px);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .feature__sub {
    margin-top: 4px;
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.16em;
  }

  .feature__note {
    max-width: 44ch;
    margin-top: 10px;
    color: var(--text-muted);
    font-size: 11.5px;
    line-height: 1.75;
  }

  .feature__meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 12px;
    padding-top: 9px;
    border-top: 1px solid var(--line);
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.12em;
  }

  .feature__meta span:nth-child(2) { margin-left: auto; }

  .feature__score { color: var(--accent-text); }

  .feature__index { min-width: 0; }

  .feature__head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0 8px;
    border-top: 1px solid var(--line-strong);
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.18em;
  }

  .feature__row {
    position: relative;
    display: grid;
    grid-template-columns: 24px 56px minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 10px;
    padding-block: 9px;
    border-top: 1px solid var(--line);
    cursor: pointer;
    opacity: 0;
    translate: 0 10px;
    transition:
      opacity 520ms var(--ease-expo) var(--d, 0ms),
      translate 620ms var(--ease-expo) var(--d, 0ms);
  }

  .reveal.is-in .feature__row {
    opacity: 1;
    translate: 0 0;
  }

  .feature__row:last-child { border-bottom: 1px solid var(--line); }

  .feature__row::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 480ms var(--ease-expo);
  }

  .feature__row:hover::after { transform: scaleX(1); }

  .feature__row.is-active::after { transform: scaleX(1); }

  .feature__row.is-active .feature__row-name {
    color: var(--accent-text);
  }

  .feature__row.is-active .feature__row-thumb img {
    filter: none;
    scale: 1.04;
  }

  .feature__row-num {
    color: var(--text-muted);
    font-size: var(--fs-nano);
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
  }

  .feature__row-thumb {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--bg-elevated);
  }

  .feature__row-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.25) brightness(0.9);
    transition:
      scale 520ms var(--ease-expo),
      filter 400ms var(--ease-quart);
  }

  .feature__row:hover .feature__row-thumb img {
    scale: 1.06;
