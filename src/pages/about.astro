<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- 滚入入场 ---------- */
  const revealEls = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
  if (reduceMotion) {
    revealEls.forEach((el) => el.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
    );
    revealEls.forEach((el) => io.observe(el));
  }

  /* ---------- 左侧页码：阅读进度 + 当前章节 ---------- */
  const railProgress = document.querySelector<HTMLElement>('[data-rail-progress]');
  const railCount = document.querySelector<HTMLElement>('[data-rail-count]');
  const railSecs = Array.from(document.querySelectorAll<HTMLElement>('.about .sec'));
  if (railProgress && railSecs.length) {
    let railTick = false;
    const syncRail = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      railProgress.style.transform = `scaleY(${p.toFixed(3)})`;
      if (railCount) {
        const line = window.innerHeight * 0.42;
        let current = 0;
        railSecs.forEach((sec, index) => {
          if (sec.getBoundingClientRect().top <= line) current = index;
        });
        railCount.textContent = String(current + 1).padStart(2, '0');
      }
      railTick = false;
    };
    syncRail();
    window.addEventListener(
      'scroll',
      () => {
        if (railTick) return;
        railTick = true;
        requestAnimationFrame(syncRail);
      },
      { passive: true },
    );
    window.addEventListener('resize', syncRail);
  }

  /* ---------- 数字滚动 ---------- */
  function formatCount(value: number, mode: string | undefined, suffix: string | undefined) {
    let text: string;
    if (mode === 'pad') text = String(Math.round(value)).padStart(2, '0');
    else if (mode === 'compact') {
      text =
        value >= 10000
          ? `${(value / 10000).toFixed(1).replace(/\.0$/, '')}w`
          : value >= 1000
            ? `${(value / 1000).toFixed(1).replace(/\.0$/, '')}k`
            : String(Math.round(value));
    } else text = String(Math.round(value));
    return text + (suffix ?? '');
  }

  function countUp(el: HTMLElement) {
    const target = Number(el.dataset.count ?? '0');
    const mode = el.dataset.mode;
    const suffix = el.dataset.suffix;
    if (reduceMotion || target === 0) {
      el.textContent = formatCount(target, mode, suffix);
      return;
    }
    const start = performance.now();
    const dur = 900;
    const tick = (now: number) => {
      const t = Math.min(1, (now - start) / dur);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = formatCount(target * eased, mode, suffix);
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  const countEls = Array.from(document.querySelectorAll<HTMLElement>('[data-count]'));
  if (reduceMotion) {
    countEls.forEach(countUp);
  } else {
    const countIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            countUp(entry.target as HTMLElement);
            countIO.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.6 },
    );
    countEls.forEach((el) => countIO.observe(el));
  }

  /* ---------- 打字机 ---------- */
  const typeEl = document.querySelector<HTMLElement>('[data-typewriter]');
  if (typeEl) {
    const lines: string[] = JSON.parse(typeEl.dataset.lines ?? '[]');
    if (reduceMotion || lines.length === 0) {
      typeEl.textContent = lines[0] ?? '';
    } else {
      let line = 0;
      let char = 0;
      let deleting = false;
      const step = () => {
        const text = lines[line];
        if (!deleting) {
          char += 1;
          typeEl.textContent = text.slice(0, char);
          if (char >= text.length) {
            deleting = true;
            window.setTimeout(step, 1900);
            return;
          }
          window.setTimeout(step, 78 + Math.random() * 62);
        } else {
          char -= 1;
          typeEl.textContent = text.slice(0, char);
          if (char <= 0) {
            deleting = false;
            line = (line + 1) % lines.length;
            window.setTimeout(step, 420);
            return;
          }
          window.setTimeout(step, 34);
        }
      };
      step();
    }
  }

  /* ---------- 技能雷达 ---------- */
  const radarCanvas = document.querySelector<HTMLCanvasElement>('[data-radar]');
  if (radarCanvas) {
    const ctx = radarCanvas.getContext('2d');
    const axes: { label: string; value: number }[] = JSON.parse(radarCanvas.dataset.axes ?? '[]');
    if (ctx && axes.length) {
      const isLight = () => document.documentElement.dataset.theme === 'light';
      const palette = () =>
        isLight()
          ? { line: 'rgba(18,19,22,0.14)', text: '#5c5f66', accent: '90,107,0', cyan: '11,143,143' }
          : { line: 'rgba(231,230,225,0.14)', text: '#8c8f96', accent: '216,255,62', cyan: '52,224,224' };

      let progress = reduceMotion ? 1 : 0;
      let raf = 0;

      const draw = () => {
        const rect = radarCanvas.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        radarCanvas.width = Math.round(rect.width * dpr);
        radarCanvas.height = Math.round(rect.height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const p = palette();
        const cx = rect.width / 2;
        const cy = rect.height / 2 + 6;
        const radius = Math.min(rect.width, rect.height) / 2 - 34;
        const n = axes.length;
        const point = (i: number, scale: number) => {
          const angle = -Math.PI / 2 + (i / n) * Math.PI * 2;
          return { x: cx + Math.cos(angle) * radius * scale, y: cy + Math.sin(angle) * radius * scale };
        };

        ctx.lineWidth = 1;
        for (let ring = 1; ring <= 4; ring += 1) {
          ctx.strokeStyle = p.line;
          ctx.beginPath();
          for (let i = 0; i <= n; i += 1) {
            const pt = point(i % n, ring / 4);
            if (i === 0) ctx.moveTo(pt.x, pt.y);
            else ctx.lineTo(pt.x, pt.y);
          }
          ctx.stroke();
        }
        for (let i = 0; i < n; i += 1) {
          const pt = point(i, 1);
          ctx.strokeStyle = p.line;
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(pt.x, pt.y);
          ctx.stroke();
          const lp = point(i, 1.2);
          ctx.fillStyle = p.text;
          ctx.font = `11px "JetBrains Mono", ui-monospace, monospace`;
          ctx.textAlign = lp.x < cx - 6 ? 'right' : lp.x > cx + 6 ? 'left' : 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(axes[i].label, lp.x, lp.y);
        }

        const eased = 1 - Math.pow(1 - progress, 3);
        ctx.beginPath();
        for (let i = 0; i <= n; i += 1) {
          const pt = point(i % n, axes[i % n].value * eased);
          if (i === 0) ctx.moveTo(pt.x, pt.y);
          else ctx.lineTo(pt.x, pt.y);
        }
        ctx.closePath();
        ctx.fillStyle = `rgba(${p.accent}, 0.14)`;
        ctx.fill();
        ctx.strokeStyle = `rgba(${p.accent}, 0.95)`;
        ctx.lineWidth = 1.5;
        ctx.stroke();
        for (let i = 0; i < n; i += 1) {
          const pt = point(i, axes[i].value * eased);
          ctx.fillStyle = `rgba(${p.cyan}, 0.95)`;
          ctx.beginPath();
          ctx.arc(pt.x, pt.y, 2.4, 0, Math.PI * 2);
          ctx.fill();
        }
      };

      const animate = () => {
        const start = performance.now();
        const dur = 1000;
        const tick = (now: number) => {
          progress = Math.min(1, (now - start) / dur);
          draw();
          if (progress < 1) raf = requestAnimationFrame(tick);
        };
        raf = requestAnimationFrame(tick);
      };

      draw();
      if (!reduceMotion) {
        const radarIO = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                cancelAnimationFrame(raf);
                animate();
                radarIO.disconnect();
              }
            });
          },
          { threshold: 0.4 },
        );
        radarIO.observe(radarCanvas);
      }
      window.addEventListener('resize', draw);
      new MutationObserver(draw).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
    }
  }

  /* ---------- 专长进度条 ---------- */
  const barIO = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-in');
          barIO.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.5 },
  );
  document.querySelectorAll('.skill-bar').forEach((el) => {
    if (reduceMotion) el.classList.add('is-in');
    else barIO.observe(el);
  });

  /* ---------- ID 卡倾斜 ---------- */
  document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((tiltCard) => {
    if (reduceMotion) return;
    tiltCard.addEventListener('pointermove', (e) => {
      const rect = tiltCard.getBoundingClientRect();
      const rx = ((e.clientY - rect.top) / rect.height - 0.5) * -7;
      const ry = ((e.clientX - rect.left) / rect.width - 0.5) * 9;
      tiltCard.style.transform = `perspective(720px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg)`;
      tiltCard.style.setProperty('--mx', `${((e.clientX - rect.left) / rect.width) * 100}%`);
      tiltCard.style.setProperty('--my', `${((e.clientY - rect.top) / rect.height) * 100}%`);
    });
    tiltCard.addEventListener('pointerleave', () => {
      tiltCard.style.transform = '';
    });
  });

  /* ---------- 幽灵字视差（滚动 + 指针） ---------- */
  const ghost = document.querySelector<HTMLElement>('[data-ghost]');
  if (ghost && !reduceMotion) {
    let ghostX = 0;
    let ticking = false;
    const applyGhost = () => {
      ghost.style.translate = `${ghostX.toFixed(1)}px ${(window.scrollY * 0.18).toFixed(1)}px`;
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(applyGhost);
      },
      { passive: true },
    );
    const heroInner = document.querySelector<HTMLElement>('.about-hero__grid');
    heroInner?.addEventListener('pointermove', (e) => {
      ghostX = (e.clientX / window.innerWidth - 0.5) * 26;
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(applyGhost);
      }
    });
  }

  /* ---------- 卡片光斑跟随 ---------- */
  document.querySelectorAll<HTMLElement>('[data-spot]').forEach((card) => {
    if (reduceMotion) return;
    card.addEventListener('pointermove', (e) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${((e.clientX - rect.left) / rect.width) * 100}%`);
      card.style.setProperty('--my', `${((e.clientY - rect.top) / rect.height) * 100}%`);
    });
  });

  /* ---------- 邮箱复制 ---------- */
  document.querySelectorAll<HTMLElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      const hint = btn.parentElement?.querySelector<HTMLElement>('.contact__hint');
      try {
        await navigator.clipboard.writeText(text);
        if (hint) {
          hint.textContent = '已复制 ✓';
          window.setTimeout(() => {
            hint.textContent = '点击复制';
          }, 1400);
        }
      } catch {
        window.prompt('复制邮箱：', text);
      }
    });
  });

  /* ---------- 06 娱乐：游戏清单轮播 ---------- */
  const feature = document.querySelector<HTMLElement>('[data-feature]');
  if (feature) {
    type GameInfo = {
      img: string;
      title: string;
      sub: string;
      note: string;
      hours: string;
      score: string;
      platform: string;
    };

    const gamesData: GameInfo[] = JSON.parse(feature.dataset.games ?? '[]');
    const rows = Array.from(feature.querySelectorAll<HTMLElement>('[data-feature-row]'));
    const heroImg = feature.querySelector<HTMLImageElement>('[data-feature-img]');
    const badge = feature.querySelector<HTMLElement>('[data-feature-badge]');
    const idxEl = feature.querySelector<HTMLElement>('[data-feature-idx]');
    const titleEl = feature.querySelector<HTMLElement>('[data-feature-title]');
    const subEl = feature.querySelector<HTMLElement>('[data-feature-sub]');
    const noteEl = feature.querySelector<HTMLElement>('[data-feature-note]');
    const hoursEl = feature.querySelector<HTMLElement>('[data-feature-hours]');
    const platformEl = feature.querySelector<HTMLElement>('[data-feature-platform]');
    const scoreEl = feature.querySelector<HTMLElement>('[data-feature-score]');

    const pad = (n: number) => String(n + 1).padStart(2, '0');
    const total = String(gamesData.length).padStart(2, '0');

    let current = 0;
    let timer = 0;
    let inView = true;

    const show = (index: number) => {
      const game = gamesData[index];
      if (!game) return;
      current = index;

      if (heroImg) {
        heroImg.src = game.img;
        heroImg.alt = game.title;
      }
      if (badge) badge.textContent = `FEATURED ${pad(index)}`;
      if (idxEl) idxEl.textContent = `${pad(index)} / ${total}`;
      if (titleEl) titleEl.textContent = game.title;
      if (subEl) subEl.textContent = game.sub;
      if (noteEl) noteEl.textContent = game.note;
      if (hoursEl) hoursEl.textContent = `${game.hours}H`;
      if (platformEl) platformEl.textContent = game.platform;
      if (scoreEl) scoreEl.textContent = `★ ${game.score}`;

      rows.forEach((row) => {
        const on = Number(row.dataset.index) === index;
        row.classList.toggle('is-active', on);
        row.setAttribute('aria-current', on ? 'true' : 'false');
      });
    };

    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = 0;
    };
    const start = () => {
      stop();
      if (reduceMotion || !inView || gamesData.length < 2) return;
      timer = window.setInterval(() => show((current + 1) % gamesData.length), 5200);
    };

    const pick = (index: number) => {
      show(index);
      start();
    };

    rows.forEach((row) => {
      row.addEventListener('click', () => pick(Number(row.dataset.index)));
      row.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          pick(Number(row.dataset.index));
        }
      });
    });

    feature.addEventListener('pointerenter', stop);
    feature.addEventListener('pointerleave', start);
    feature.addEventListener('focusin', stop);
    feature.addEventListener('focusout', start);

    const mediaSection = document.querySelector<HTMLElement>('#media');
    if (mediaSection) {
      const featureIO = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            inView = entry.isIntersecting;
            if (inView) start();
            else stop();
          });
        },
        { threshold: 0.3 },
      );
      featureIO.observe(mediaSection);
    } else {
      start();
    }

    show(0);
  }
</script>

