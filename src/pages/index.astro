---
import { ClientRouter } from 'astro:transitions';
import { getPosts, wordCount } from '../lib/content';
import { padNumber, formatCompact } from '../lib/format';
import { SITE } from '../lib/site';
import '../styles/global.css';

const posts = await getPosts();
const words = wordCount(posts);

const bootLines = [
  'SYS.BOOT / MISIRO OS v1.1',
  `CONTENT ...... ${padNumber(posts.length)} POSTS / ${formatCompact(words)} WORDS`,
  'RENDER ....... STATIC / ZERO RUNTIME',
  'SEARCH ....... PAGEFIND READY',
  'TRACKING ..... NONE',
];

const titleChars = ['M', 'I', 'S', 'I', 'R', 'O'];
const levelBars = Array.from({ length: 12 }, (_, index) => index);
const scanBars = Array.from({ length: 24 }, (_, index) => index);
const lockDots = Array.from({ length: 9 }, (_, index) => index);
---

<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.title}</title>
    <meta name="description" content={SITE.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0E0F12" />

    <style is:inline>
      html {
        background: #0e0f12;
      }
      html[data-theme='light'] {
        background: #f2f1ec;
      }
    </style>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var saved = localStorage.getItem('misiro-theme');
          root.dataset.theme = saved === 'light' ? 'light' : 'dark';
        } catch (e) {
          root.dataset.theme = 'dark';
        }
        root.classList.add('js');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) return;
        var seen = false;
        try {
          seen = Boolean(sessionStorage.getItem('misiro-splash'));
          sessionStorage.setItem('misiro-splash', '1');
        } catch (e) {}
        root.dataset.splash = seen ? 'quick' : 'first';
        // 兜底：脚本未启动时 3.4s 后强制显示内容
        setTimeout(function () {
          if (!window.__splashBoot) root.removeAttribute('data-splash');
        }, 3400);
      })();
    </script>

    <ClientRouter />
  </head>

  <body class="splash-body">
    <main class="splash" data-splash>
      <!-- 全屏信号场：粒子 / 透视网格 / 数码雨 / 冲击波 -->
      <canvas class="splash-canvas" aria-hidden="true"></canvas>

      <!-- CRT 暗角 -->
      <div class="splash-vignette" aria-hidden="true"></div>

      <!-- 点击爆闪 -->
      <div class="splash-flash" aria-hidden="true"></div>

      <!-- 网点底纹，圆形擦除入场 -->
      <div class="splash-field" aria-hidden="true" data-boot></div>

      <!-- CRT 扫描线 -->
      <div class="splash-scanlines" aria-hidden="true"></div>

      <!-- 巨型描边幽灵字 -->
      <div class="splash-ghost" aria-hidden="true" data-boot>MISIRO</div>

      <!-- 网格框线与 HUD 角标 -->
      <div class="splash-frame" aria-hidden="true">
        <span class="splash-frame__line splash-frame__line--t" data-boot></span>
        <span class="splash-frame__line splash-frame__line--b" data-boot></span>
        <span class="splash-frame__line splash-frame__line--l" data-boot></span>
        <span class="splash-frame__line splash-frame__line--r" data-boot></span>
        <span class="hud-corner hud-corner--tl"></span>
        <span class="hud-corner hud-corner--tr"></span>
        <span class="hud-corner hud-corner--bl"></span>
        <span class="hud-corner hud-corner--br"></span>
      </div>

      <!-- 左右刻度尺 -->
      <div class="splash-ruler splash-ruler--l" aria-hidden="true" data-boot style="--base:900ms"></div>
      <div class="splash-ruler splash-ruler--r" aria-hidden="true" data-boot style="--base:960ms"></div>

      <!-- 启动进度：沿底部框线充能 -->
      <div class="splash-progress" aria-hidden="true">
        <span class="splash-progress__bar"></span>
      </div>

      <!-- 三道扫描带 -->
      <div class="splash-bars" aria-hidden="true">
        <span class="splash-bar splash-bar--1" data-boot></span>
        <span class="splash-bar splash-bar--2" data-boot></span>
        <span class="splash-bar splash-bar--3" data-boot></span>
      </div>

      <header class="splash-top mono">
        <span data-boot style="--base:80ms">SIGNAL OK / NO COOKIES</span>
        <span data-boot style="--base:160ms">31.23°N / 121.47°E</span>
        <span class="splash-readout" data-boot style="--base:240ms">
          <span data-clock>00:00:00</span>
          <span class="splash-readout__sep">/</span>
          <span data-fps>60</span> FPS
        </span>
      </header>

      <section class="splash-core">
        <div class="splash-sticker-row" data-boot style="--base:300ms">
          <span class="sticker sticker--accent">DEV LOG / EST. {SITE.startYear}</span>
          <span class="mono splash-ver">STATIC / ASTRO / CLOUDFLARE</span>
        </div>

        <div class="splash-title-wrap">
          <div class="splash-cut" aria-hidden="true" data-boot style="--base:260ms"></div>

          <div class="splash-title-shell">
            <h1 class="splash-title" aria-label={SITE.name}>
              {
                titleChars.map((char, index) => (
                  <span
                    class="splash-char"
                    style={`--base:${420 + index * 58}ms;--idle-delay:${(index * 0.14).toFixed(2)}s;--blast-delay:${index * 24}ms`}
                    data-boot
                    aria-hidden="true"
                  >
                    {char}
                  </span>
                ))
              }
            </h1>
            <span
              class="splash-echo splash-echo--cyan"
              aria-hidden="true"
              data-boot
              style="--base:840ms">{SITE.name}</span
            >
            <span
              class="splash-echo splash-echo--magenta"
              aria-hidden="true"
              data-boot
              style="--base:900ms">{SITE.name}</span
            >
            <span
              class="splash-echo splash-echo--stroke"
              aria-hidden="true"
              data-boot
              style="--base:960ms">{SITE.name}</span
            >
          </div>

          <div class="splash-rule-wrap" aria-hidden="true">
            <div class="splash-rule" data-boot style="--base:1040ms"></div>
            <div class="splash-rule-tick" data-boot style="--base:1460ms"></div>
          </div>
        </div>

        <p class="splash-tag" data-boot style="--base:1120ms">
          把构建当作作品。 <span class="splash-tag-en mono">BUILD AS CRAFT.</span>
        </p>

        <ul class="splash-boot mono" aria-label="启动日志">
          {
            bootLines.map((line, index) => (
              <li
                class="splash-boot-line"
                data-boot
                style={`--base:${1380 + index * 72}ms;--ok-delay:${(index * 0.18).toFixed(2)}s`}
              >
                <span class="splash-boot-ok" aria-hidden="true">▮</span>
                <span class="splash-boot-text" data-scramble>{line}</span>
              </li>
            ))
          }
          <li class="splash-boot-caret" aria-hidden="true" data-boot style="--base:1800ms">
            <span></span>
          </li>
        </ul>

        <div class="splash-actions">
          <a class="splash-enter" href="/home" data-enter>
            <span class="splash-enter__bg" aria-hidden="true"></span>
            <span class="splash-enter__corner splash-enter__corner--tl" aria-hidden="true"></span>
            <span class="splash-enter__corner splash-enter__corner--tr" aria-hidden="true"></span>
            <span class="splash-enter__corner splash-enter__corner--bl" aria-hidden="true"></span>
            <span class="splash-enter__corner splash-enter__corner--br" aria-hidden="true"></span>
            <span class="splash-enter__label">进入 ENTER</span>
            <span class="splash-enter__arrow" aria-hidden="true">→</span>
          </a>
          <span class="mono splash-hint" data-boot style="--base:2100ms">CLICK / PRESS ⏎</span>
        </div>
      </section>

      <footer class="splash-foot mono">
        <span data-boot style="--base:180ms">
          {padNumber(posts.length)} POSTS / {formatCompact(words)} WORDS
        </span>
        <span data-boot style="--base:240ms">v1.1 / 不追踪 / 无弹窗</span>
      </footer>

      <div class="splash-cross" aria-hidden="true" data-boot style="--base:1500ms">
        <span class="splash-cross__sweep" aria-hidden="true"></span>
        <span class="splash-cross__blip" aria-hidden="true"></span>
        <svg viewBox="0 0 120 120">
          <circle cx="60" cy="60" r="46" fill="none" stroke="var(--line-strong)" stroke-width="1"></circle>
          <circle cx="60" cy="60" r="58" fill="none" stroke="var(--accent)" stroke-width="1" stroke-dasharray="4 12"></circle>
          <circle cx="60" cy="60" r="30" fill="none" stroke="var(--accent)" stroke-width="1"></circle>
          <path d="M60 0v18M60 102v18M0 60h18M102 60h18" stroke="var(--text-muted)" stroke-width="1"></path>
        </svg>
        <span class="splash-cross__az mono" data-az>AZ 000°</span>
      </div>

      <div class="splash-side mono" aria-hidden="true" data-boot style="--base:1700ms">
        BUILD AS CRAFT — {SITE.startYear}
      </div>

      <!-- 左下：信号电平，随指针速度与点击能量起伏 -->
      <div class="splash-level" aria-hidden="true" data-boot style="--base:1720ms">
        <span class="splash-level__bars">
          {
            levelBars.map((bar) => (
              <span
                class="splash-level__bar"
                style={`--d:${(0.62 + bar * 0.045).toFixed(2)}s;--delay:${(bar * -0.16).toFixed(2)}s;--from:${(0.22 + bar * 0.012).toFixed(3)};--to:${(0.68 + bar * 0.018).toFixed(3)}`}
              />
            ))
          }
        </span>
        <span class="splash-level__tag mono">SIG LVL 01</span>
      </div>

      <!-- 左下角：频段扫描 -->
      <div class="splash-scan" aria-hidden="true" data-boot style="--base:1880ms">
        <span class="splash-scan__bars">
          {
            scanBars.map((bar) => (
              <span
                class="splash-scan__bar"
                style={`--d:${(1.1 + bar * 0.035).toFixed(2)}s;--delay:${(bar * -0.08).toFixed(2)}s;--to:${(0.42 + bar * 0.024).toFixed(3)}`}
              />
            ))
          }
        </span>
        <span class="splash-scan__sweep" aria-hidden="true"></span>
        <span class="splash-scan__tag mono">0.4–9.8 kHz</span>
      </div>

      <!-- 右上：目标锁定框，点击时收缩上锁 -->
      <div class="splash-lock" aria-hidden="true" data-boot style="--base:1700ms">
        <span class="splash-lock__dash" aria-hidden="true"></span>
        <span class="splash-lock__corner splash-lock__corner--tl" aria-hidden="true"></span>
        <span class="splash-lock__corner splash-lock__corner--tr" aria-hidden="true"></span>
        <span class="splash-lock__corner splash-lock__corner--bl" aria-hidden="true"></span>
        <span class="splash-lock__corner splash-lock__corner--br" aria-hidden="true"></span>
        <span class="splash-lock__matrix" aria-hidden="true">
          {
            lockDots.map((dot) => <span style={`--delay:${(dot * -0.14).toFixed(2)}s`} />)
          }
        </span>
        <span class="splash-lock__tag mono">LOCK 02</span>
      </div>

      <!-- 胶片颗粒 -->
      <div class="splash-grain" aria-hidden="true"></div>

      <!-- 指针准星（仅精细指针） -->
      <div class="splash-reticle" aria-hidden="true">
        <span class="splash-reticle__h"></span>
        <span class="splash-reticle__v"></span>
        <span class="splash-reticle__c"></span>
      </div>

      <!-- 点击进入时的全屏擦除 -->
      <div class="splash-cover" aria-hidden="true"></div>
    </main>

    <script>
      import { createSignalField } from '../scripts/splash-field';

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const fine = window.matchMedia('(pointer: fine)').matches;
      const splash = document.querySelector<HTMLElement>('.splash');
      const root = document.documentElement;
      const mode = root.dataset.splash;
      const animated = !reduce && (mode === 'first' || mode === 'quick');

      (window as unknown as Record<string, unknown>).__splashBoot = true;

      const k = mode === 'quick' ? 0.34 : 1;

      if (splash && animated) {
        splash.classList.add('is-booting');

        // 启动日志：字符逐格解码
        const lines = splash.querySelectorAll<HTMLElement>('[data-scramble]');
        const glyphs = '0123456789ABCDEF#%&/<>_▮';
        const scramble = (el: HTMLElement, duration: number) => {
          const finalText = el.dataset.text ?? el.textContent ?? '';
          el.dataset.text = finalText;
          const start = performance.now();
          const tick = (now: number) => {
            const progress = Math.min(1, (now - start) / duration);
            const revealed = Math.floor(progress * finalText.length);
            let out = '';
            for (let i = 0; i < finalText.length; i += 1) {
              const char = finalText[i];
              if (i < revealed || char === ' ') {
                out += char;
              } else {
                out += glyphs[Math.floor(Math.random() * glyphs.length)];
              }
            }
            el.textContent = out;
            if (progress < 1) {
              requestAnimationFrame(tick);
            } else {
              el.textContent = finalText;
            }
          };
          requestAnimationFrame(tick);
        };

        window.setTimeout(() => {
          lines.forEach((line, index) => {
            window.setTimeout(() => scramble(line, 520), index * 40);
          });
        }, 1380 * k);

        window.setTimeout(() => {
          splash.classList.add('is-done');
          root.removeAttribute('data-splash');
        }, 2800 * k);
      }

      // ---------- 全屏信号场 ----------
      const canvas = document.querySelector<HTMLCanvasElement>('.splash-canvas');
      let field: ReturnType<typeof createSignalField> | null = null;

      if (canvas && splash && !reduce) {
        field = createSignalField(canvas, {
          onTear: () => {
            // 与 Canvas 撕裂同步的 DOM 抖帧
            splash.classList.remove('is-tearing');
            void splash.offsetWidth;
            splash.classList.add('is-tearing');
            window.setTimeout(() => splash.classList.remove('is-tearing'), 160);
          },
        });

        // 入场：一道贯穿全屏的冲击波
        window.setTimeout(() => {
          field?.burst(window.innerWidth / 2, window.innerHeight * 0.46);
        }, 160 * k);
      }

      // ---------- 标题四层视差 ----------
      const echoes = {
        cyan: document.querySelector<HTMLElement>('.splash-echo--cyan'),
        magenta: document.querySelector<HTMLElement>('.splash-echo--magenta'),
        stroke: document.querySelector<HTMLElement>('.splash-echo--stroke'),
      };
      const hudLayer = document.querySelector<HTMLElement>('.splash-frame');
      const levelEl = document.querySelector<HTMLElement>('.splash-level');
      const azEl = document.querySelector<HTMLElement>('[data-az]');
      const tagEl = document.querySelector<HTMLElement>('.splash-tag');
      const charEls = Array.from(document.querySelectorAll<HTMLElement>('.splash-char'));
      let charCenters: { x: number; y: number }[] = [];

      const measureChars = () => {
        charCenters = charEls.map((el) => {
          const rect = el.getBoundingClientRect();
          return { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
        });
      };
      measureChars();
      window.addEventListener('resize', measureChars, { passive: true });
      window.setTimeout(measureChars, 3200 * k);

      // ---------- 指针：准星 + 视差 ----------
      const reticle = document.querySelector<HTMLElement>('.splash-reticle');
      let targetX = -200;
      let targetY = -200;
      let retX = -200;
      let retY = -200;
      let prevX = -200;
      let prevY = -200;
      let normX = 0;
      let normY = 0;
      let speedEase = 0;
      let hitGain = 0;
      let lastAz = -1;

      if (!reduce) {
        window.addEventListener(
          'pointermove',
          (event) => {
            targetX = event.clientX;
            targetY = event.clientY;
            normX = (event.clientX / window.innerWidth - 0.5) * 2;
            normY = (event.clientY / window.innerHeight - 0.5) * 2;
          },
          { passive: true },
        );

        const follow = (time: number) => {
          retX += (targetX - retX) * 0.18;
          retY += (targetY - retY) * 0.18;

          // 指针速度 → 电平增益；点击后再叠加一段衰减脉冲
          const step = Math.hypot(targetX - prevX, targetY - prevY);
          prevX = targetX;
          prevY = targetY;
          speedEase += (Math.min(step, 36) - speedEase) * 0.25;
          hitGain *= 0.93;
          if (levelEl) {
            const gain = Math.min(2.1, 0.55 + speedEase * 0.035 + hitGain);
            levelEl.style.setProperty('--gain', gain.toFixed(2));
          }

          // 方位角与雷达扫描同步
          const az = Math.floor((time / 5600) * 360) % 360;
          if (azEl && az !== lastAz) {
            lastAz = az;
            azEl.textContent = `AZ ${String(az).padStart(3, '0')}°`;
          }
          if (reticle) {
            reticle.style.transform = `translate3d(${(retX - 22).toFixed(1)}px, ${(retY - 22).toFixed(1)}px, 0)`;
          }
          // 四层回声以不同系数反向位移，天然产生色差
          if (echoes.cyan) {
            echoes.cyan.style.setProperty('--px', `${(-normX * 14).toFixed(1)}px`);
            echoes.cyan.style.setProperty('--py', `${(-normY * 10).toFixed(1)}px`);
          }
          if (echoes.magenta) {
            echoes.magenta.style.setProperty('--px', `${(normX * 9).toFixed(1)}px`);
            echoes.magenta.style.setProperty('--py', `${(normY * 7).toFixed(1)}px`);
          }
          if (echoes.stroke) {
            echoes.stroke.style.setProperty('--px', `${(normX * 5).toFixed(1)}px`);
            echoes.stroke.style.setProperty('--py', `${(normY * 4).toFixed(1)}px`);
          }
          if (hudLayer) {
            hudLayer.style.setProperty('--px', `${(normX * 6).toFixed(1)}px`);
            hudLayer.style.setProperty('--py', `${(normY * 5).toFixed(1)}px`);
          }
          // 主标题：指针靠近时字被磁力推开并轻微放大
          if (charCenters.length) {
            const fieldRadius = Math.min(240, window.innerWidth * 0.3);
            for (let i = 0; i < charEls.length; i += 1) {
              const el = charEls[i];
              const center = charCenters[i];
              const dx = center.x - retX;
              const dy = center.y - retY;
              const dist = Math.hypot(dx, dy) || 1;
              const force = dist < fieldRadius ? Math.pow(1 - dist / fieldRadius, 2) : 0;
              const push = force * 26;
              el.style.setProperty('--dx', `${((dx / dist) * push).toFixed(1)}px`);
              el.style.setProperty('--dy', `${((dy / dist) * push * 0.7).toFixed(1)}px`);
              el.style.setProperty('--s', (1 + force * 0.09).toFixed(3));
            }
          }
          // 文字与标题反方向位移，形成层次
          if (tagEl) {
            tagEl.style.setProperty('--tx', `${(-normX * 9).toFixed(1)}px`);
            tagEl.style.setProperty('--ty', `${(-normY * 5).toFixed(1)}px`);
          }
          requestAnimationFrame(follow);
        };
        requestAnimationFrame(follow);
      }

      // ---------- 点击：爆炸空气波 + 爆闪 + 抖帧 ----------
      if (splash && !reduce) {
        let impactTimer = 0;
        window.addEventListener(
          'pointerdown',
          (event) => {
            if ((event.target as HTMLElement)?.closest('a')) return;
            field?.burst(event.clientX, event.clientY);
            hitGain = 1.5;
            splash.style.setProperty('--bx', `${event.clientX}px`);
            splash.style.setProperty('--by', `${event.clientY}px`);
            window.clearTimeout(impactTimer);
            splash.classList.remove('is-impact');
            void splash.offsetWidth;
            splash.classList.add('is-impact');
            impactTimer = window.setTimeout(() => splash.classList.remove('is-impact'), 520);
          },
          { passive: true },
        );

        // 按住不放：全场轻微推近 + 提亮
        window.addEventListener('pointerdown', () => {
          splash.classList.add('is-charging');
        });
        window.addEventListener('pointerup', () => splash.classList.remove('is-charging'));
        window.addEventListener('pointercancel', () => splash.classList.remove('is-charging'));
      }

      // ---------- 读数：时钟 + 帧率 ----------
      const clockEl = document.querySelector<HTMLElement>('[data-clock]');
      const fpsEl = document.querySelector<HTMLElement>('[data-fps]');
      if (!reduce) {
        let frames = 0;
        let lastFpsAt = performance.now();
        const meter = () => {
          frames += 1;
          const now = performance.now();
          if (now - lastFpsAt >= 900) {
            const value = Math.round((frames * 1000) / (now - lastFpsAt));
            if (fpsEl) fpsEl.textContent = String(Math.min(value, 120));
            frames = 0;
            lastFpsAt = now;
          }
          requestAnimationFrame(meter);
        };
        requestAnimationFrame(meter);

        const tickClock = () => {
          const now = new Date();
          const pad = (n: number) => String(n).padStart(2, '0');
          if (clockEl) {
            clockEl.textContent = `${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
          }
          window.setTimeout(tickClock, 1000);
        };
        tickClock();
      }

      // ---------- 进入按钮：磁吸 + 能量 + 擦除退场 ----------
      const enter = document.querySelector<HTMLElement>('[data-enter]');
      if (enter) {
        if (!reduce && fine) {
          const strength = 16;
          enter.addEventListener('pointermove', (event) => {
            const rect = enter.getBoundingClientRect();
            const mx = ((event.clientX - rect.left) / rect.width - 0.5) * strength;
            const my = ((event.clientY - rect.top) / rect.height - 0.5) * strength;
            enter.style.setProperty('--mag-x', `${mx.toFixed(1)}px`);
            enter.style.setProperty('--mag-y', `${my.toFixed(1)}px`);
          });
          enter.addEventListener('pointerenter', () => {
            splash?.classList.add('is-focus');
          });
          enter.addEventListener('pointerleave', () => {
            splash?.classList.remove('is-focus');
            enter.style.setProperty('--mag-x', '0px');
            enter.style.setProperty('--mag-y', '0px');
          });
        }

        enter.addEventListener('click', (event) => {
          if (reduce || !splash) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          if (splash.classList.contains('is-exiting')) return;
          field?.burst(window.innerWidth / 2, window.innerHeight * 0.5);
          splash.classList.add('is-done', 'is-exiting');
          window.setTimeout(() => {
            window.location.href = '/home';
          }, 520);
        });
      }

      // ---------- 键盘：Enter 进入，Esc 跳过 ----------
      window.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' && !event.repeat) {
          document.querySelector<HTMLAnchorElement>('[data-enter]')?.click();
        }
        if (event.key === 'Escape' && splash && !splash.classList.contains('is-done')) {
          splash.classList.add('is-done');
          root.removeAttribute('data-splash');
        }
      });
    </script>
