---
import { SITE, NAV } from '../lib/site';

const year = new Date().getFullYear();
const marquee = [
  'BUILD / 构建',
  'PERF BUDGET / 性能预算',
  'MOTION / 动效',
  'TYPESET / 排版',
  'STATIC / 静态',
  'NO TRACKING / 无追踪',
  'SIGNAL OK',
];
---

<footer class="site-footer">
  <div class="warn-strip" aria-hidden="true"></div>
  <div class="foot-grid halftone">
    <div class="container foot-inner">
      <div class="foot-marquee" aria-hidden="true">
        <div class="foot-marquee__track">
          {[...marquee, ...marquee].map((item) => <span>{item}</span>)}
        </div>
      </div>

      <div class="foot-top">
        <div class="foot-block">
          <span class="kicker">SIGNAL OK / NO COOKIES</span>
          <p class="foot-tag">{SITE.tagline}</p>
        </div>

        <nav class="foot-nav" aria-label="页脚导航">
          {
            NAV.slice(0, 4).map((item) => (
              <a href={item.href}>{item.label}</a>
            ))
          }
          <a href="/projects">项目</a>
          <a href="/rss.xml">RSS</a>
        </nav>

        <div class="foot-links">
          <a href={SITE.github} rel="noreferrer" target="_blank">GITHUB ↗</a>
          <a href={`mailto:${SITE.email}`}>MAIL ↗</a>
          <a href="/rss.xml">RSS ↗</a>
        </div>
      </div>

      <div class="foot-word" data-wordmark aria-hidden="true">
        <span>MISIRO</span>
        <span class="foot-word__fill">MISIRO</span>
      </div>

      <div class="foot-bottom">
        <span>© {SITE.startYear}–{year} {SITE.name}</span>
        <span class="mono foot-clock" data-clock aria-hidden="true">--:--:-- CST</span>
        <span class="mono foot-stack">STATIC / ASTRO / CLOUDFLARE PAGES</span>
        <a class="foot-top-link" href="#main" data-magnetic>回到顶部 ↑</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(64px, 10vw, 120px);
  }

  .foot-grid {
    border-top: 1px solid var(--line);
    background: var(--bg-elevated);
  }

  .foot-inner {
    padding-top: 40px;
    padding-bottom: 28px;
  }

  .foot-marquee {
    margin-bottom: clamp(22px, 3.4vw, 38px);
    overflow: hidden;
    border-block: 1px solid var(--line);
  }

  .foot-marquee__track {
    display: flex;
    width: max-content;
    animation: foot-marquee 44s linear infinite;
    color: var(--text-muted);
    transition: color var(--dur-2) var(--ease-quart);
  }

  .foot-marquee:hover .foot-marquee__track {
    animation-play-state: paused;
    color: var(--accent-text);
  }

  .foot-marquee__track span {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 18px;
    border-right: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.14em;
    white-space: nowrap;
  }

  .foot-marquee__track span::before {
    content: '';
    width: 4px;
    height: 4px;
    background: var(--accent);
    transform: rotate(45deg);
  }

  @keyframes foot-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .foot-top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 28px;
  }

  .foot-block {
    max-width: 320px;
  }

  .foot-tag {
    margin-top: 8px;
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.3;
  }

  .foot-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }

  .foot-nav a {
    display: inline-block;
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-1),
      border-color var(--dur-1),
      transform var(--dur-1) var(--ease-quart);
  }

  .foot-nav a:hover {
    color: var(--text);
    border-color: var(--accent);
    transform: translateX(3px);
  }

  .foot-links {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .foot-links a {
    align-self: flex-start;
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-1),
      border-color var(--dur-1),
      transform var(--dur-1) var(--ease-quart);
  }

  .foot-links a:hover {
    color: var(--accent-text);
    border-color: var(--accent);
    transform: translateX(3px);
  }

  .foot-word {
    position: relative;
    margin: clamp(24px, 4vw, 48px) 0 20px;
    font-family: var(--font-display);
    font-size: clamp(64px, 14vw, 190px);
    line-height: 0.82;
    letter-spacing: -0.03em;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-strong);
    user-select: none;
  }

  .foot-word > span {
    display: block;
  }

  .foot-word__fill {
    position: absolute;
    inset: 0;
    color: var(--accent);
    -webkit-text-stroke: 1px var(--accent);
    clip-path: circle(
      var(--word-r, 0px) at var(--word-x, 50%) var(--word-y, 50%)
    );
    pointer-events: none;
  }

  .foot-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .foot-top-link {
    display: inline-block;
    transition:
      color var(--dur-1),
      transform var(--dur-2) var(--ease-spring);
  }

  .foot-top-link:hover {
    color: var(--accent-text);
    transform: translateY(-2px);
  }

  .foot-clock {
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
  }

  @media (prefers-reduced-motion: reduce) {
    .foot-marquee__track {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .foot-stack {
      display: none;
    }
  }
</style>
